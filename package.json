{
  "name": "sac-aisa",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev -w @sac-aisa/api",
    "dev:web": "npm run dev -w @sac-aisa/web",
    "build": "npm run build -w @sac-aisa/domain && npm run build -w @sac-aisa/api && npm run build -w @sac-aisa/web",
    "db:generate": "npm run prisma:generate -w @sac-aisa/api",
    "db:migrate": "npm run prisma:migrate -w @sac-aisa/api",
    "db:seed": "npm run prisma:seed -w @sac-aisa/api",
    "test:domain": "npm test -w @sac-aisa/domain"
  }
}
