# Postgres (EasyPanel)
DATABASE_URL=postgresql://sac:sac_secret@postgres:5432/sac_aisa?schema=public

# Redis (fila / cache — no EasyPanel use o host interno do serviço redis)
REDIS_URL=redis://redis:6379

# Observabilidade (opcional)
# Uptime Kuma: monitor HTTP GET {PUBLIC_API_URL}/health — espera ok=true
# Glitchtip: DSN compatível com Sentry
SENTRY_DSN=

# API
API_PORT=3001
JWT_SECRET=troque-este-segredo-em-producao
CORS_ORIGIN=http://localhost:3000
UPLOAD_DIR=./uploads
# Em EasyPanel: volume montado (ex.: /data/anexos) + URL pública dos arquivos
# UPLOAD_DIR=/data/anexos
PUBLIC_UPLOAD_URL=http://localhost:3001/uploads
PUBLIC_API_URL=http://localhost:3001

# Web
NEXT_PUBLIC_API_URL=http://localhost:3001

# IA (opcional — sem chave, usa só classificador legado / regras do SAC)
# Preferencial: OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
# Alternativa direta OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Evolution API (WhatsApp)
EVOLUTION_API_URL=http://evolution:8080
EVOLUTION_API_KEY=troque-a-chave-da-evolution
EVOLUTION_INSTANCE=sac-aisa
EVOLUTION_WEBHOOK_SECRET=

# Alertas
ALERT_AGUARDANDO_DIAS=7
ALERT_META_DIAS=2
ALERT_CUSTO_ALTO=500
ALERT_OUTROS_DIAS=3
ALERT_RASCUNHO_WHATSAPP_HORAS=24

# Backup Postgres (pg_dump no volume /data/backups)
# BACKUP_DIR=/data/backups
BACKUP_RETENTION=20
# BACKUP_CRON=0  desliga o dump automático diário (03:00)

# WhatsApp gestor (somente leitura: KPI, CAUSAS, SETOR, PPM, ALERTAS)
# Telefones com DDI (55…). Se a Evolution só mandar LID, pode colocar o número do LID também.
# GESTOR_WHATSAPP_TELEFONES=5511999999999,5511888888888
# Deixe EVOLUTION_WEBHOOK_SECRET vazio se o Manager da Evolution não enviar header.
